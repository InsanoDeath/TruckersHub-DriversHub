<!DOCTYPE html>
<html lang="en">

<meta http-equiv="content-type" content="text/html;charset=utf-8" />

<head>
    <title>
        <%= user.username %> | <%= config.vtcName %>
    </title>
    
    <%- include("../partials/head.ejs") %>
</head>

<body class="g-sidenav-show  bg-gray-100">
    <aside class="sidenav navbar navbar-vertical navbar-expand-xs border-0 border-radius-xl my-3 fixed-start ms-3" id="sidenav-main">
        <%- include("../partials/sidebar") %>
    </aside>
    <main class="main-content position-relative max-height-vh-100 h-100 border-radius-lg ">
        <nav class="navbar navbar-main navbar-expand-lg position-sticky mt-4 top-1 px-0 mx-4 shadow-none border-radius-xl z-index-sticky" id="navbarBlur" data-scroll="true">
            <%- include("../partials/header") %>
        </nav>

        <div class="container-fluid py-4">
            <div class="row">
                <div class="col-lg-10">
                
                    <!-- Profile Header -->
                    <div class="text-center mb-5">
                        <!-- Avatar -->
                        <div class="avatar avatar-xxl avatar-circle profile-cover-avatar">
                        <img class="avatar-img" src="/<%= user.avatar %>" alt="Image Description">
                        <span class="avatar-status avatar-status-success"></span>
                        </div>
                        <!-- End Avatar -->
            
                        <h1 class="page-header-title">
                            <%= user.username %>
                        </h1>
            
                        <!-- List -->
                        <ul class="list-inline list-px-2">
                        <li class="list-inline-item">
                            <a href="https://steamcommunity.com/profiles/<%= user.steamID %>"
                                target="_blank" class="btn btn-social-icon mr-1 btn-github">
                                <i class="bi-steam me-1"></i>
                                Steam
                            </a>
                        </li>
            
                        <li class="list-inline-item">
                            <a href="https://truckersmp.com/user/<%= user.TMPID %>" target="_blank"
                                class="btn btn-social-icon mr-1 btn-twitter">
                                <i class="bi-truck me-1"></i>
                                TruckersMP
                            </a>
                        </li>
            
                        <% if (user.discord) { %>
                            <li class="list-inline-item">
                                <a href="https://discord.com/users/<%= user.discord.id %>"
                                    target="_blank" class="btn btn-social-icon mr-1 btn-instagram">
                                    <i class="bi-discord me-1"></i>
                                    Discord
                                </a>
                            </li>
                        <% } %>
                        </ul>
                        <!-- End List -->
                    </div>
                    <!-- End Profile Header -->
            
                    <div class="row">
                        <div class="col-lg-4">
                            <div class="card">
                                <div class="card-header">
                                    <h4>Details</h4>
                                </div>
                                <div class="card-body">
                                    <div class="py-4">
                                        <p class="clearfix">
                                            <span class="float-left">
                                                Rank:
                                            </span>
                                            <span class="float-right text-muted">
                                                <%= user.rank %>
                                            </span>
                                        </p>
                                        <p class="clearfix">
                                            <span class="float-left">
                                                UserID:
                                            </span>
                                            <span class="float-right text-muted">
                                                <%= user.userID %>
                                            </span>
                                        </p>
                                        <p class="clearfix">
                                            <span class="float-left">
                                                Registered On:
                                            </span>
                                            <span class="float-right text-muted">
                                                <%= new Date(user.joinedDate).toLocaleDateString() %>
                                            </span>
                                        </p>
                                        <p class="clearfix">
                                            <span class="float-left">
                                                Country:
                                            </span>
                                            <span class="float-right text-muted">
                                                <%= user.country %>
                                            </span>
                                        </p>
                                        <p class="clearfix">
                                            <span class="float-left">
                                                Games:
                                            </span>
                                            <span class="float-right text-muted">
                                                <%= user.games.join(", ").toUpperCase() %>
                                            </span>
                                        </p>
                                        <p class=" clearfix">
                                                    <span class="float-left">
                                                        Total Points Earned:
                                                    </span>
                                                    <span class="float-right text-muted">
                                                        <%= user.points.toFixed(2) %> Points
                                                    </span>
                                        </p>
                                        <p class="clearfix">
                                            <span class="float-left">
                                                Total Distance:
                                            </span>
                                            <span class="float-right text-muted">
                                                <%= parseInt(user.distance).toLocaleString() %> km
                                            </span>
                                        </p>
                                        <p class="clearfix">
                                            <span class="float-left">
                                                Total Jobs:
                                            </span>
                                            <span class="float-right text-muted">
                                                <%= user.jobs.toLocaleString() %>
                                            </span>
                                        </p>
                                        <div class="d-flex justify-content-center pt-2">
                                            <% if(user.userID==data.userID) { %>
                                                <a href="/profile/settings"
                                                    class="btn btn-primary me-1 waves-effect waves-float waves-light">
                                                    Settings
                                                </a>
                                            <% } %>
                                            <% if (["manageUsers"].find(f => perms.includes(f))) { %>
                                                <a href="/user/<%= user.userID %>/remove"
                                                    class="btn btn-danger me-1 waves-effect waves-float waves-light">
                                                    Remove User
                                                </a>
                                            <% } %>
                                                    <!-- <a href="javascript:;"
                                                class="btn btn-outline-danger suspend-user waves-effect">Suspended</a> -->
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
            
                        <div class="col-lg-8">
                            <div class="card">
                                <div class="card-header">
                                    User Jobs
                                </div>
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table class="table table-striped" id="jobs">
                                            <thead>
                                                <tr>
                                                    <th>Date</th>
                                                    <th>From-To</th>
                                                    <th>Cargo</th>
                                                    <th>Distance</th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% for(var i=0; i < jobs.length; i++) { %>
                                                    <tr>
                                                        <td>
                                                            <%= new Date(jobs[i].realtime.end).toUTCString() %>
                                                        </td>
                                                        <td>
                                                            <%= jobs[i].source.city.name %> - <%=
                                                            jobs[i].destination.city.name %>
                                                        </td>
                                                        <td>
                                                            <%= jobs[i].cargo.name %> (<%=
                                                                    Math.round(jobs[i].cargo.mass / 1000) %>t)
                                                        </td>
                                                        <td>
                                                            <%= Math.round(jobs[i].distanceDriven).toLocaleString()
                                                                %> km
                                                        </td>
                                                        <td>
                                                            <a href="/jobs/<%= jobs[i].jobID %>">
                                                                <button type="button"
                                                                    class="btn btn-primary waves-effect waves-light">
                                                                    Details
                                                                </button>
                                                            </a>
                                                        </td>
                                                    </tr>
                                                <% } %>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- End Row -->
                </div>
                <!-- End Col -->
            </div>
            <footer class="footer pt-3">
                <%- include("../partials/footer") %>
            </footer>
        </div>
    </main>

    <script src="/js/core/popper.min.js"></script>
    <script src="/js/core/bootstrap.min.js"></script>
    <script src="/js/plugins/perfect-scrollbar.min.js"></script>
    <script src="/js/plugins/smooth-scrollbar.min.js"></script>

    <script src="/js/plugins/dragula/dragula.min.js"></script>
    <script src="/js/plugins/jkanban/jkanban.js"></script>
    <script src="/js/plugins/chartjs.min.js"></script>
    <script src="/js/plugins/threejs.js"></script>
    <script src="/js/plugins/orbit-controls.js"></script>
</body>

</html>