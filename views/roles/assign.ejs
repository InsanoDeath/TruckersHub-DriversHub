<!DOCTYPE html>
<html lang="en">

<meta http-equiv="content-type" content="text/html;charset=utf-8" />

<head>
    <title>
        Assign Role | <%= config.vtcName %>
    </title>
    
    <%- include("../../partials/head.ejs") %>
</head>

<body class="g-sidenav-show  bg-gray-100">
    <aside class="sidenav navbar navbar-vertical navbar-expand-xs border-0 border-radius-xl my-3 fixed-start ms-3" id="sidenav-main">
        <%- include("../../partials/sidebar") %>
    </aside>
    <main class="main-content position-relative max-height-vh-100 h-100 border-radius-lg ">
        <nav class="navbar navbar-main navbar-expand-lg position-sticky mt-4 top-1 px-0 mx-4 shadow-none border-radius-xl z-index-sticky" id="navbarBlur" data-scroll="true">
            <%- include("../../partials/header") %>
        </nav>

        <div class="container-fluid py-4">
            <div class="row">
                <div class="col-12 col-md-12 col-lg-12 mt-4">
                    <form action="/roles/assign" method="post" class="needs-validation">
                        <div class="card">
                            <div class="card-header">
                                <h4>Assign Role</h4>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-12 col-sm-6">
                                        <label for="user" class="form-label">User</label>
                                        <select class="form-control" style="width: 100%;" id="user" name="user">
                                            <% for (var i=0; i < members.length; i++) { %>
                                                <option value="<%= members[i].userID %>">
                                                    <%= members[i].username %>
                                                </option>
                                                <% } %>
                                        </select>
                                    </div>
                                    <div class="col-12 col-sm-6">
                                        <label class="form-label" for="role">Role</label>
                                        <select class="form-control" id="role" name="role" autocomplete="off">
                                            <option selected disabled>
                                                Select Role
                                            </option>
                                            <% for(var i=0; i < roles.length; i++) { %>
                                                <option value="<%= roles[i].id %>">
                                                    <%= roles[i].name %>
                                                </option>
                                                <% } %>
                                        </select>
                                    </div>
                                    <div class="form-check col-12">
                                        <input class="form-check-input" type="checkbox"
                                            id="isRoleSecondary" name="isRoleSecondary" value="checked">
                                        &nbsp;
                                        <label class="form-check-label" for="isRoleSecondary">Is Role
                                            Secondary</label>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer">
                                <button type="submit" id="submit"
                                    class="btn btn-success btn-rounded mb-2 me-4 _effect--ripple waves-effect waves-light">
                                    Assign Role
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <footer class="footer pt-3">
                <%- include("../../partials/footer") %>
            </footer>
        </div>
    </main>

    <script src="/js/core/popper.min.js"></script>
    <script src="/js/core/bootstrap.min.js"></script>
    <script src="/js/plugins/perfect-scrollbar.min.js"></script>
    <script src="/js/plugins/smooth-scrollbar.min.js"></script>

    <script src="/js/plugins/dragula/dragula.min.js"></script>
    <script src="/js/plugins/jkanban/jkanban.js"></script>
    <script src="/js/plugins/chartjs.min.js"></script>
    <script src="/js/plugins/threejs.js"></script>
    <script src="/js/plugins/orbit-controls.js"></script>

    <script src="/js/plugins/choices.min.js"></script>
    <script>
        if (document.getElementById('user')) {
            var country = document.getElementById('user');
            const example = new Choices(country);
        }
    </script>
</body>

</html>