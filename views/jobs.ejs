<!DOCTYPE html>
<html lang="en">

<meta http-equiv="content-type" content="text/html;charset=utf-8" />

<head>
    <title>
        Jobs | <%= config.vtcName %>
    </title>
    
    <%- include("../partials/head.ejs") %>
</head>

<body class="g-sidenav-show  bg-gray-100">
    <aside class="sidenav navbar navbar-vertical navbar-expand-xs border-0 border-radius-xl my-3 fixed-start ms-3" id="sidenav-main">
        <%- include("../partials/sidebar") %>
    </aside>
    <main class="main-content position-relative max-height-vh-100 h-100 border-radius-lg ">
        <nav class="navbar navbar-main navbar-expand-lg position-sticky mt-4 top-1 px-0 mx-4 shadow-none border-radius-xl z-index-sticky" id="navbarBlur" data-scroll="true">
            <%- include("../partials/header") %>
        </nav>

        <div class="container-fluid py-4">
            <div class="row">
                <div class="col-12 col-md-12 col-lg-12">
                    <div class="card">
                        <div class="card-header">
                            Users List
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-striped" id="jobs">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>User</th>
                                            <th>From-To</th>
                                            <th>Cargo</th>
                                            <th>Distance</th>
                                            <th>Income</th>
                                            <th>XP</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% for(var i=0; i < jobs.length; i++) { %>
                                            <tr>
                                                <td>
                                                    <%= new Date(jobs[i].realtime.end).toUTCString() %>
                                                </td>
                                                <td>
                                                    <%= jobs[i].driver.username %>
                                                </td>
                                                <td>
                                                    <%= jobs[i].source.city.name %> - <%= jobs[i].destination.city.name %>
                                                </td>
                                                <td>
                                                    <%= jobs[i].cargo.name %> (<%= Math.round(jobs[i].cargo.mass / 1000) %>t)
                                                </td>
                                                <td>
                                                    <%= Math.round(jobs[i].distanceDriven).toLocaleString() %> km
                                                </td>
                                                <td>
                                                    € <%= Math.round(jobs[i].income).toLocaleString() %>
                                                </td>
                                                <td>
                                                    <%= Math.round(jobs[i].earnedXP).toLocaleString() %> XP
                                                </td>
                                                <td>
                                                    <a href="/jobs/<%= jobs[i].jobID %>">
                                                        <button type="button" class="btn btn-primary waves-effect waves-light">
                                                            Details
                                                        </button>
                                                    </a>
                                                </td>
                                            </tr>
                                            <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <footer class="footer pt-3">
                <%- include("../partials/footer") %>
            </footer>
        </div>
    </main>

    <script src="/js/core/popper.min.js"></script>
    <script src="/js/core/bootstrap.min.js"></script>
    <script src="/js/plugins/perfect-scrollbar.min.js"></script>
    <script src="/js/plugins/smooth-scrollbar.min.js"></script>

    <script src="/js/plugins/dragula/dragula.min.js"></script>
    <script src="/js/plugins/jkanban/jkanban.js"></script>
    <script src="/js/plugins/chartjs.min.js"></script>
    <script src="/js/plugins/threejs.js"></script>
    <script src="/js/plugins/orbit-controls.js"></script>

    <script src="/js/plugins/datatables.js"></script>
    <script>
        const dataTableSearch = new simpleDatatables.DataTable("#jobs", {
            searchable: true,
            fixedHeight: true
        });
    </script>
</body>

</html>