<!DOCTYPE html>
<html lang="en">

<meta http-equiv="content-type" content="text/html;charset=utf-8" />

<head>
    <title>
        Leaderboard | <%= config.vtcName %>
    </title>
    
    <%- include("../partials/head.ejs") %>
</head>

<body class="g-sidenav-show  bg-gray-100">
    <aside class="sidenav navbar navbar-vertical navbar-expand-xs border-0 border-radius-xl my-3 fixed-start ms-3" id="sidenav-main">
        <%- include("../partials/sidebar") %>
    </aside>
    <main class="main-content position-relative max-height-vh-100 h-100 border-radius-lg ">
        <nav class="navbar navbar-main navbar-expand-lg position-sticky mt-4 top-1 px-0 mx-4 shadow-none border-radius-xl z-index-sticky" id="navbarBlur" data-scroll="true">
            <%- include("../partials/header") %>
        </nav>

        <div class="container-fluid py-4">
            <!--Row-->
            <div class="row row-sm mt-3 mb-3 me-3">
                <div class="col-12">
                    <h1>Monthly Leaderboard</h1>
                </div>
                <!-- Points Leaderboard -->
                <div class="col-4 mb-4">
                    <div class="card">
                        <div class="card-body">
                            <div class="card-title">
                                Points
                            </div>
                            <div class="card-text">
                                <% members.sort((a, b)=> { %>
                                    <% return parseFloat(b?.monthly?.points || 0) - parseFloat(a?.monthly?.points || 0); %>
                                <% }) %>
                                <% for(var i=0; i < 20; i++) { %>
                                    <% if(members[i]) { %>
                                        <div style="margin-bottom: 20px;"
                                            class="employee-task d-flex justify-content-between align-items-center">
                                            <div class="d-flex flex-row align-items-center">
                                                <%= i + 1 %>) &nbsp;
                                                    <div class="me-75">
                                                        <img src="/<%= members[i].avatar %>"
                                                            class="rounded-circle avatar-sm" style="margin-right: 10px;"
                                                            alt="Avatar">
                                                    </div>
                                                    <div class="my-auto">
                                                        <h6 class="mb-0"><%= members[i].username %></h6>
                                                        <small><%= members[i].rank %></small>
                                                    </div>
                                            </div>
                                            <div class="d-flex align-items-center">
                                                <small class="text-muted me-75">
                                                    <%= parseFloat(members[i]?.monthly?.points).toLocaleString() %> points
                                                </small>
                                            </div>
                                        </div>
                                    <% } %>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Distance Leaderboard -->
                <div class="col-4 mb-4">
                    <div class="card">
                        <div class="card-body">
                            <div class="card-title">
                                Distance
                            </div>
                            <div class="card-text">
                                <% members.sort((a, b)=> { %>
                                    <% return parseInt(b?.monthly?.distance || 0) - parseInt(a?.monthly?.distance || 0); %>
                                <% }) %>
                                <% for(var i=0; i < 20; i++) { %>
                                    <% if(members[i]) { %>
                                        <div style="margin-bottom: 20px;"
                                            class="employee-task d-flex justify-content-between align-items-center">
                                            <div class="d-flex flex-row align-items-center">
                                                <%= i + 1 %>) &nbsp;
                                                    <div class="me-75">
                                                        <img src="/<%= members[i].avatar %>"
                                                            class="rounded-circle avatar-sm" style="margin-right: 10px;"
                                                            alt="Avatar">
                                                    </div>
                                                    <div class="my-auto">
                                                        <h6 class="mb-0"><%= members[i].username %></h6>
                                                        <small><%= members[i].rank %></small>
                                                    </div>
                                            </div>
                                            <div class="d-flex align-items-center">
                                                <small class="text-muted me-75">
                                                    <%= parseInt(members[i]?.monthly?.distance).toLocaleString() %> km
                                                </small>
                                            </div>
                                        </div>
                                    <% } %>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Jobs Leaderboard -->
                <div class="col-4 mb-4">
                    <div class="card">
                        <div class="card-body">
                            <div class="card-title">
                                Total Jobs Done
                            </div>
                            <div class="card-text">
                                <% members.sort((a, b)=> { %>
                                    <% return parseInt(b?.monthly?.jobs || 0) - parseInt(a?.monthly?.jobs || 0); %>
                                <% }) %>
                                <% for(var i=0; i < 20; i++) { %>
                                    <% if(members[i]) { %>
                                        <div style="margin-bottom: 20px;"
                                            class="employee-task d-flex justify-content-between align-items-center">
                                            <div class="d-flex flex-row align-items-center">
                                                <%= i + 1 %>) &nbsp;
                                                    <div class="me-75">
                                                        <img src="/<%= members[i].avatar %>"
                                                            class="rounded-circle avatar-sm" style="margin-right: 10px;"
                                                            alt="Avatar">
                                                    </div>
                                                    <div class="my-auto">
                                                        <h6 class="mb-0"><%= members[i].username %></h6>
                                                        <small><%= members[i].rank %></small>
                                                    </div>
                                            </div>
                                            <div class="d-flex align-items-center">
                                                <small class="text-muted me-75">
                                                    <%= parseInt(members[i]?.monthly?.jobs).toLocaleString() %>
                                                </small>
                                            </div>
                                        </div>
                                    <% } %>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- All time Leaderboard -->
                <div class="col-12">
                    <h1>Leaderboard</h1>
                </div>
                <!-- Points Leaderboard -->
                <div class="col-4 mb-4">
                    <div class="card">
                        <div class="card-body">
                            <div class="card-title">
                                Points
                            </div>
                            <div class="card-text">
                                <% members.sort((a, b)=> { %>
                                    <% return parseInt(b?.points || 0) - parseInt(a?.points || 0); %>
                                <% }) %>
                                <% for(var i=0; i < 20; i++) { %>
                                    <% if(members[i]) { %>
                                        <div style="margin-bottom: 20px;"
                                            class="employee-task d-flex justify-content-between align-items-center">
                                            <div class="d-flex flex-row align-items-center">
                                                <%= i + 1 %>) &nbsp;
                                                    <div class="me-75">
                                                        <img src="/<%= members[i].avatar %>"
                                                            class="rounded-circle avatar-sm" style="margin-right: 10px;"
                                                            alt="Avatar">
                                                    </div>
                                                    <div class="my-auto">
                                                        <h6 class="mb-0"><%= members[i].username %></h6>
                                                        <small><%= members[i].rank %></small>
                                                    </div>
                                            </div>
                                            <div class="d-flex align-items-center">
                                                <small class="text-muted me-75">
                                                    <%= members[i].points.toLocaleString() %> Points
                                                </small>
                                            </div>
                                        </div>
                                    <% } %>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Distance Leaderboard -->
                <div class="col-4 mb-4">
                    <div class="card">
                        <div class="card-body">
                            <div class="card-title">
                                Distance
                            </div>
                            <div class="card-text">
                                <% members.sort((a, b)=> { %>
                                    <% return parseInt(b?.distance || 0) - parseInt(a?.distance || 0); %>
                                <% }) %>
                                <% for(var i=0; i < 20; i++) { %>
                                    <% if(members[i]) { %>
                                        <div style="margin-bottom: 20px;"
                                            class="employee-task d-flex justify-content-between align-items-center">
                                            <div class="d-flex flex-row align-items-center">
                                                <%= i + 1 %>) &nbsp;
                                                    <div class="me-75">
                                                        <img src="/<%= members[i].avatar %>"
                                                            class="rounded-circle avatar-sm" style="margin-right: 10px;"
                                                            alt="Avatar">
                                                    </div>
                                                    <div class="my-auto">
                                                        <h6 class="mb-0"><%= members[i].username %></h6>
                                                        <small><%= members[i].rank %></small>
                                                    </div>
                                            </div>
                                            <div class="d-flex align-items-center">
                                                <small class="text-muted me-75">
                                                    <%= members[i].distance.toLocaleString() %> km
                                                </small>
                                            </div>
                                        </div>
                                    <% } %>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Jobs Leaderboard -->
                <div class="col-4 mb-4">
                    <div class="card">
                        <div class="card-body">
                            <div class="card-title">
                                Total Jobs Done
                            </div>
                            <div class="card-text">
                                <% members.sort((a, b)=> { %>
                                    <% return parseInt(b?.jobs || 0) - parseInt(a?.jobs || 0); %>
                                <% }) %>
                                <% for(var i=0; i < 20; i++) { %>
                                    <% if(members[i]) { %>
                                        <div style="margin-bottom: 20px;"
                                            class="employee-task d-flex justify-content-between align-items-center">
                                            <div class="d-flex flex-row align-items-center">
                                                <%= i + 1 %>) &nbsp;
                                                    <div class="me-75">
                                                        <img src="/<%= members[i].avatar %>"
                                                            class="rounded-circle avatar-sm" style="margin-right: 10px;"
                                                            alt="Avatar">
                                                    </div>
                                                    <div class="my-auto">
                                                        <h6 class="mb-0"><%= members[i].username %></h6>
                                                        <small><%= members[i].rank %></small>
                                                    </div>
                                            </div>
                                            <div class="d-flex align-items-center">
                                                <small class="text-muted me-75">
                                                    <%= members[i].jobs?.toLocaleString() %>
                                                </small>
                                            </div>
                                        </div>
                                    <% } %>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Row end -->
            <footer class="footer pt-3">
                <%- include("../partials/footer") %>
            </footer>
        </div>
    </main>

    <script src="/js/core/popper.min.js"></script>
    <script src="/js/core/bootstrap.min.js"></script>
    <script src="/js/plugins/perfect-scrollbar.min.js"></script>
    <script src="/js/plugins/smooth-scrollbar.min.js"></script>

    <script src="/js/plugins/dragula/dragula.min.js"></script>
    <script src="/js/plugins/jkanban/jkanban.js"></script>
    <script src="/js/plugins/chartjs.min.js"></script>
    <script src="/js/plugins/threejs.js"></script>
    <script src="/js/plugins/orbit-controls.js"></script>
</body>

</html>