<!DOCTYPE html>
<html lang="en">

<meta http-equiv="content-type" content="text/html;charset=utf-8" />

<head>
    <title>
        <%= config.vtcName %>
    </title>
    
    <%- include("../partials/head.ejs") %>
</head>

<body class="g-sidenav-show  bg-gray-100">
    <aside class="sidenav navbar navbar-vertical navbar-expand-xs border-0 border-radius-xl my-3 fixed-start ms-3" id="sidenav-main">
        <%- include("../partials/sidebar") %>
    </aside>
    <main class="main-content position-relative max-height-vh-100 h-100 border-radius-lg ">
        <nav class="navbar navbar-main navbar-expand-lg position-sticky mt-4 top-1 px-0 mx-4 shadow-none border-radius-xl z-index-sticky" id="navbarBlur" data-scroll="true">
            <%- include("../partials/header") %>
        </nav>

        <div class="container-fluid py-4">
            <div class="row">
                <div class="col-lg-12 position-relative z-index-2">
                    <div class="card card-plain mb-4">
                        <div class="card-body p-3">
                            <div class="row">
                                <div class="col-lg-6">
                                    <div class="d-flex flex-column h-100">
                                        <h2 class="font-weight-bolder mb-0">General Statistics</h2>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-3 col-sm-6">
                            <div class="card mb-4">
                                <div class="card-body p-3">
                                    <div class="row">
                                        <div class="col-8">
                                            <div class="numbers">
                                                <p class="text-sm mb-0 text-capitalize font-weight-bold">
                                                    Total Distance
                                                </p>
                                                <h5 class="font-weight-bolder mb-0">
                                                    <%= main.distance.toLocaleString() %> km
                                                </h5>
                                            </div>
                                        </div>
                                        <div class="col-4 text-end">
                                            <div class="icon icon-shape bg-gradient-primary shadow text-center border-radius-md">
                                                <i class="fa-solid fa-route text-lg opacity-10"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-sm-6">
                            <div class="card ">
                                <div class="card-body p-3">
                                    <div class="row">
                                        <div class="col-8">
                                            <div class="numbers">
                                                <p class="text-sm mb-0 text-capitalize font-weight-bold">
                                                    Total Jobs
                                                </p>
                                                <h5 class="font-weight-bolder mb-0">
                                                    <%= main.jobs.toLocaleString() %>
                                                </h5>
                                            </div>
                                        </div>
                                        <div class="col-4 text-end">
                                            <div class="icon icon-shape bg-gradient-primary shadow text-center border-radius-md">
                                                <i class="fa-solid fa-truck text-lg opacity-10"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-sm-6">
                            <div class="card  mb-4">
                                <div class="card-body p-3">
                                    <div class="row">
                                        <div class="col-8">
                                            <div class="numbers">
                                                <p class="text-sm mb-0 text-capitalize font-weight-bold">
                                                    Fuel Consumed
                                                </p>
                                                <h5 class="font-weight-bolder mb-0">
                                                    <%= main.fuel.toLocaleString() %> l
                                                </h5>
                                            </div>
                                        </div>
                                        <div class="col-4 text-end">
                                            <div class="icon icon-shape bg-gradient-primary shadow text-center border-radius-md">
                                                <i class="fa-solid fa-gas-pump text-lg opacity-10"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-sm-6">
                            <div class="card ">
                                <div class="card-body p-3">
                                    <div class="row">
                                        <div class="col-8">
                                            <div class="numbers">
                                                <p class="text-sm mb-0 text-capitalize font-weight-bold">
                                                    Total Earnings
                                                </p>
                                                <h5 class="font-weight-bolder mb-0">
                                                    $<%= main.income.toLocaleString() %>
                                                </h5>
                                            </div>
                                        </div>
                                        <div class="col-4 text-end">
                                            <div class="icon icon-shape bg-gradient-primary shadow text-center border-radius-md">
                                                <i class="fa-solid fa-dollar-sign text-lg opacity-10"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!--row-->
                    <div class="row mb-3 mb-lg-5">
                        <div class="col-sm-12 col-md-8">
                            <div class="card custom-card overflow-hidden">
                                <div class="card-header border-bottom-0">
                                    <div>
                                        <label class="main-content-label mb-2">Jobs Chart</label>
                                    </div>
                                </div>
                                <div class="card-body ps-0">
                                    <div class>
                                        <div class="container">
                                            <canvas id="distChart" height="300"></canvas>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- col end -->
                        <div class="col-sm-12 col-md-4">
                            <div class="card custom-card overflow-hidden">
                                <div class="card-header border-bottom-0">
                                    <div>
                                        <label class="main-content-label mb-2">ETS2 V/S ATS</label>
                                    </div>
                                </div>
                                <div class="card-body ps-0">
                                    <div class>
                                        <div class="container">
                                            <canvas id="etsats" height="300"></canvas>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Row end -->
            <div class="row mb-5">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4>Recent Jobs</h4>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Driver</th>
                                            <th>From-To</th>
                                            <th>Cargo</th>
                                            <th>Cargo Mass</th>
                                            <th>Distance</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% for (var i = (jobs.length || 0) - 1; i >= (((jobs.length || 0) - 10) > 0 ? (jobs.length || 0) - 10 : 0); i--) { %>
                                            <tr>
                                                <td>
                                                    <%= jobs[i].jobID %>
                                                </td>
                                                <td>
                                                    <%= jobs[i].driver.username %>
                                                </td>
                                                <td>
                                                    <%= jobs[i].source.city.name %> - <%= jobs[i].destination.city.name %>
                                                </td>
                                                <td>
                                                    <%= jobs[i].cargo.name %>
                                                </td>
                                                <td>
                                                    <%= Math.round(jobs[i].cargo.mass).toLocaleString() %> t
                                                </td>
                                                <td>
                                                    <%= Math.round(jobs[i].distanceDriven).toLocaleString() %> km
                                                </td>
                                                <td>
                                                    <a href="/jobs/<%= jobs[i].jobID %>" class="btn btn-primary">
                                                        Detail
                                                    </a>
                                                </td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <footer class="footer pt-3">
                <%- include("../partials/footer") %>
            </footer>
        </div>
    </main>

    <script src="/js/core/popper.min.js"></script>
    <script src="/js/core/bootstrap.min.js"></script>
    <script src="/js/plugins/perfect-scrollbar.min.js"></script>
    <script src="/js/plugins/smooth-scrollbar.min.js"></script>

    <script src="/js/plugins/dragula/dragula.min.js"></script>
    <script src="/js/plugins/jkanban/jkanban.js"></script>
    <script src="/js/plugins/chartjs.min.js"></script>
    <script src="/js/plugins/threejs.js"></script>
    <script src="/js/plugins/orbit-controls.js"></script>

    <script>
        var jobs = `<%- JSON.stringify(jobs).split("\\").join("\/").split("\`").join("'") %>`;
        var data = `<%- JSON.stringify(main) %>`;
    </script>
    <script src="/myjs/index.js"></script>
</body>

</html>