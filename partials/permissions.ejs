<h5>Permissions</h5>
<!-- General Perms -->
<div class="row mb-3">
    <h6 style="width: 100%;">General Permissions</h6>
    <div class="form-check col-sm-12 col-md-6">
        <input class="form-check-input" type="checkbox" id="manageUsers" name="manageUsers">
        <label class="form-check-label text-danger" for="manageUsers">
            Manage Users
        </label>
    </div>
    <div class="form-check col-sm-12 col-md-6">
        <input class="form-check-input" type="checkbox" id="manageJobs" name="manageJobs">
        <label class="form-check-label text-danger" for="manageJobs">
            Manage Jobs
        </label>
    </div>
</div>
<!-- Roles Perms -->
<div class="row mb-3">
    <h6 style="width: 100%;">Roles Permissions</h6>
    <div class="form-check col-sm-12 col-md-6">
        <input class="form-check-input" type="checkbox" id="manageRoles" name="manageRoles">
        <label class="form-check-label text-danger" for="manageRoles">
            Manage Roles
        </label>
    </div>
    <div class="form-check col-sm-12 col-md-6">
        <input class="form-check-input" type="checkbox" id="viewRoles" name="viewRoles">
        <label class="form-check-label" for="viewRoles">
            View Roles
        </label>
    </div>
    <div class="form-check col-sm-12 col-md-6">
        <input class="form-check-input" type="checkbox" id="createRoles" name="createRoles">
        <label class="form-check-label" for="createRoles">
            Create Roles
        </label>
    </div>
    <div class="form-check col-sm-12 col-md-6">
        <input class="form-check-input" type="checkbox" id="assignRoles" name="assignRoles">
        <label class="form-check-label" for="assignRoles">
            Assign Roles
        </label>
    </div>
</div>